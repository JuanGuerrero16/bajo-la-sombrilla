# Copia este archivo como .env y cambia los valores.
# No compartas el archivo .env ni lo subas a internet.

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=sombrilla
DB_PASSWORD=pon-aqui-una-clave-segura
DB_NAME=bajo_la_sombrilla

# Clave para firmar las sesiones (genera una larga y aleatoria)
JWT_SECRET=pon-aqui-una-clave-larga-y-aleatoria

# Cuenta de administración que se crea en el primer arranque
ADMIN_EMAIL=admin@bajolasombrilla.org
ADMIN_PASSWORD=CambiaEstaClave2026*

# Cuenta profesional de demostración (solo en desarrollo).
# En producción no se crea: la administración debe crear las cuentas.
PROF_EMAIL=psicologa@bajolasombrilla.org
PROF_PASSWORD=Profesional2026*

# Puerto del servidor
PORT=3000
